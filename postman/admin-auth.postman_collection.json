{
  "info": {
    "name": "HouseLink Day 8 Admin Auth",
    "description": "Provision an admin using npm run admin:provision. Configure a persistent MFA encryption key. Run First enrollment once OR Later login, then Business workflows and Sessions. Use the cookie jar. Setup replaces challengeToken. Enter the authenticator code locally; save recovery codes privately from the confirmation response. Do not export credentials or secrets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
