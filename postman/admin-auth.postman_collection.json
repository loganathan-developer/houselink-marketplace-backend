      "value": "buyer@example.test",
      "type": "string"
    },
    {
      "key": "buyerOtp",
      "value": "",
      "type": "string"
    },
    {
      "key": "buyerChallengeId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. First enrollment (once)",
      "item": [
        {
          "name": "Password login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Protection",
                "value": "1"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"challengeToken\", pm.response.json().data.challengeToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup MFA and replace challenge token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Protection",
                "value": "1"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/auth/mfa/setup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "auth",
                "mfa",
                "setup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeToken\": \"{{challengeToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"challengeToken\", pm.response.json().data.challengeToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm MFA (save recovery codes privately)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Protection",
                "value": "1"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/auth/mfa/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "auth",
                "mfa",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeToken\": \"{{challengeToken}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
