{
  "info": {
    "name": "HouseLink Category API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Public requests disable cookies. Buyer tests use real OTP login. Admin requests are skipped by default: staff login/MFA is not implemented. Do not manually promote a buyer or fabricate credentials. enableAdminRequests only enables collection execution; it grants no server permissions."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categorySlug",
      "value": "",
      "type": "string"
    },
    {
      "key": "buyerPhone",
      "value": "+918765445278",
      "type": "string"
    },
    {
      "key": "challengeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "123456",
      "type": "string"
    },
    {
      "key": "adminCategoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "enableAdminRequests",
      "value": "false",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "A. Public - no login",
      "item": [
        {
          "name": "1. List visible categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories?page=1&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const first = pm.response.json().data?.categories?.[0];",
                  "if (first) { pm.collectionVariables.set('categoryId', first.id); pm.collectionVariables.set('categorySlug', first.slug); }"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "2. Root categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories?rootOnly=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "3. Direct children",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories?parentId={{categoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "4. Category tree",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories/tree"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "5. Category by slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories/slug/{{categorySlug}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        },
        {
          "name": "6. Category by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories/{{categoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        }
      ]
    },
    {
      "name": "B. Buyer - denied admin access",
      "item": [
        {
          "name": "1. Request buyer OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Protection",
                "value": "1"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/otp/request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{buyerPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('challengeId', pm.response.json().data.challengeId);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Verify buyer OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Protection",
                "value": "1"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/otp/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Buyer admin list denied",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Buyer admin detail denied",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/categories/{{categoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Buyer category creation denied",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Protection",
                "value": "1"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Denied\",\n  \"slug\": \"denied-example\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Buyer category update denied",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Protection",
                "value": "1"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/categories/{{categoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Denied\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "C. Admin - pending real staff authentication",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('enableAdminRequests') !== 'true') { pm.execution.skipRequest(); }"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "1. Admin list",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Admin detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/categories/{{categoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Create category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Protection",
                "value": "1"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman example\",\n  \"slug\": \"postman-{{$guid}}\",\n  \"parentId\": null,\n  \"sortOrder\": 10,\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('adminCategoryId', pm.response.json().data.category.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Update category",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Protection",
                "value": "1"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/categories/{{adminCategoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated in Postman\",\n  \"sortOrder\": 20,\n  \"isActive\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
