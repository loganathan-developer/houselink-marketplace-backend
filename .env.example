NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/houselink_dev
# Tests require a separate local database. Configure this in .env.test or the shell:
# TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@localhost:5432/houselink_auth_step15_test
FRONTEND_ORIGIN=http://localhost:3000
# Empty means direct connections. Set only the actual proxy IPs/CIDRs, comma-separated.
TRUST_PROXY=
COOKIE_SAME_SITE=lax
# Secure is mandatory in production; omit COOKIE_SECURE there or set it true.
COOKIE_SECURE=false
# Generate independent random values (at least 32 characters); placeholders cannot boot production.
JWT_SECRET=replace-with-independently-generated-jwt-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=houselink-backend
JWT_AUDIENCE=houselink-web

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_IDLE_EXPIRES_IN_SECONDS=604800
SESSION_ABSOLUTE_EXPIRES_IN_SECONDS=2592000

OTP_EXPIRES_IN_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_WINDOW_SECONDS=600
OTP_REQUEST_MAX_PER_WINDOW=10
OTP_DESTINATION_WINDOW_SECONDS=3600
OTP_DESTINATION_MAX_PER_WINDOW=5

OTP_PROVIDER=mock
# Development convenience only: when true with NODE_ENV=development and OTP_PROVIDER=mock,
# any 6-digit numeric OTP is accepted. Production rejects this flag.
ALLOW_ANY_DEV_OTP=true
# Optional internal/debug endpoint only; frontend login does not need it.
# Production rejects mock delivery and retrieval.
ENABLE_MOCK_OTP_RETRIEVAL=false

OTP_HASH_SECRET=replace-with-secure-otp-hash-secret

# Admin auth is unavailable until a persistent 32-byte random hex key is configured.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ADMIN_MFA_ENCRYPTION_KEY=<64-hex-characters>
ADMIN_MFA_ISSUER=HouseLink Admin
# Explicit inputs for npm run admin:provision (development only).
# DEV_ADMIN_EMAIL=admin@example.test
# DEV_ADMIN_PASSWORD=<unique-password-12-to-128-characters>
