generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

model RateLimitBucket {
  key       String   @id
  hits      Int
  expiresAt DateTime @db.Timestamptz(6)

  @@index([expiresAt])
}

enum AuthProvider {
  PHONE
  EMAIL
  GOOGLE
}

enum OtpChannel {
  PHONE
  EMAIL
}

enum OtpPurpose {
  LOGIN
  LINK_IDENTITY
}

enum SessionContext {
  CUSTOMER
  STAFF
}

enum AttributeType {
  SELECT
  MULTI_SELECT
  TEXT
  NUMBER
  BOOLEAN
}

enum BrandStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaPurpose {
  CATEGORY_IMAGE
  BRAND_LOGO
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                 String                @id @default(uuid()) @db.Uuid
  name               String?
  // Contact-only email; login identities remain in AuthIdentity.
  email              String?               @map("contactEmail")
  profileImage       String?
  addresses          UserAddress[]
  status             UserStatus            @default(ACTIVE)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)
  roles              UserRole[]
  identities         AuthIdentity[]
  passwordCredential PasswordCredential?
  otpChallenges      OtpChallenge[]
  sessions           AuthSession[]
  adminMfa           AdminMfaCredential?
  adminChallenges    AdminLoginChallenge[]
  adminRecoveryCodes AdminRecoveryCode[]
  uploadedMedia      Media[]
  cart               Cart?
  wishlistItems      WishlistItem[]
}

enum AdminChallengePurpose {
  MFA_SETUP
  MFA_ENROLLMENT
  MFA_LOGIN
}

model AdminMfaCredential {
  userId               String    @id @db.Uuid
  encryptedSecret      String
  activatedAt          DateTime? @db.Timestamptz(6)
  lastAcceptedTotpStep BigInt?
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(6)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model AdminLoginChallenge {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @db.Uuid
  tokenHash         String                @unique
  purpose           AdminChallengePurpose
  passwordChangedAt DateTime              @db.Timestamptz(6)
  expiresAt         DateTime              @db.Timestamptz(6)
  attemptCount      Int                   @default(0)
  maxAttempts       Int                   @default(5)
  consumedAt        DateTime?             @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model AdminRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String    @unique
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, consumedAt])
}

model UserAddress {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  recipientName String
  contactPhone  String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String
  country       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model Category {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  slug         String              @unique
  description  String?
  imageUrl     String?
  imageMediaId String?             @db.Uuid
  imageMedia   Media?              @relation("CategoryImageMedia", fields: [imageMediaId], references: [id], onDelete: Restrict)
  parentId     String?             @db.Uuid
  parent       Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]          @relation("CategoryHierarchy")
  attributes   CategoryAttribute[]
  products     Product[]
  isActive     Boolean             @default(true)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)

  @@index([parentId, sortOrder])
  @@index([isActive])
  @@index([imageMediaId])
}

model Attribute {
  id         String              @id @default(uuid()) @db.Uuid
  name       String
  code       String              @unique
  type       AttributeType
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(6)
  values     AttributeValue[]
  categories CategoryAttribute[]

  @@index([isActive])
}

model AttributeValue {
  id          String    @id @default(uuid()) @db.Uuid
  attributeId String    @db.Uuid
  value       String
  label       String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@unique([attributeId, value])
  @@index([attributeId, sortOrder])
  @@index([isActive])
}

model CategoryAttribute {
  categoryId      String    @db.Uuid
  attributeId     String    @db.Uuid
  isRequired      Boolean   @default(false)
  isFilterable    Boolean   @default(true)
  isVariantOption Boolean   @default(false)
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attribute       Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@id([categoryId, attributeId])
  @@index([attributeId])
  @@index([categoryId, sortOrder])
  @@index([isActive])
}

model Brand {
  id              String      @id @default(uuid()) @db.Uuid
  name            String      @db.VarChar(120)
  normalizedName  String      @unique @db.VarChar(120)
  slug            String      @unique @db.VarChar(160)
  description     String?     @db.VarChar(2000)
  logoUrl         String?     @db.VarChar(2048)
  logoMediaId     String?     @db.Uuid
  logoMedia       Media?      @relation("BrandLogoMedia", fields: [logoMediaId], references: [id], onDelete: Restrict)
  status          BrandStatus @default(PENDING)
  isActive        Boolean     @default(true)
  rejectionReason String?     @db.VarChar(1000)
  approvedAt      DateTime?   @db.Timestamptz(3)
  rejectedAt      DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  products        Product[]

  @@index([status, isActive, name, id])
  @@index([logoMediaId])
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(180)
  slug        String        @unique @db.VarChar(200)
  description String?       @db.VarChar(3000)
  categoryId  String        @db.Uuid
  brandId     String        @db.Uuid
  status      ProductStatus @default(DRAFT)
  basePrice   Decimal       @db.Decimal(12, 2)
  salePrice   Decimal?      @db.Decimal(12, 2)
  imageUrl    String?       @db.VarChar(2048)
  publishedAt DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand       Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  wishlistItems WishlistItem[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([brandId])
  @@index([salePrice])
}

model ProductVariant {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @db.Uuid
  sku       String    @unique @db.VarChar(100)
  size      String?   @db.VarChar(40)
  color     String?   @db.VarChar(80)
  price     Decimal?  @db.Decimal(12, 2)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory Inventory?
  cartItems CartItem[]

  @@index([productId, isActive])
}

model Inventory {
  id        String         @id @default(uuid()) @db.Uuid
  variantId String         @unique @db.Uuid
  quantity  Int            @default(0)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([quantity])
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Media {
  id           String       @id @default(uuid()) @db.Uuid
  storageKey   String       @unique @db.VarChar(512)
  mimeType     String       @db.VarChar(100)
  sizeBytes    Int
  width        Int
  height       Int
  purpose      MediaPurpose
  uploadedById String       @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  categories   Category[]   @relation("CategoryImageMedia")
  brands       Brand[]      @relation("BrandLogoMedia")

  @@index([purpose])
  @@index([uploadedById])
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique
  userRoles UserRole[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model AuthIdentity {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  provider   AuthProvider
  identifier String
  verifiedAt DateTime     @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, identifier])
  @@index([userId])
}

model PasswordCredential {
  userId            String   @id @db.Uuid
  passwordHash      String
  passwordChangedAt DateTime @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model OtpChallenge {
  id            String     @id @default(uuid()) @db.Uuid
  destination   String
  channel       OtpChannel
  purpose       OtpPurpose
  userId        String?    @db.Uuid
  codeDigest    String
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime   @db.Timestamptz(6)
  attemptCount  Int        @default(0)
  consumedAt    DateTime?  @db.Timestamptz(6)
  invalidatedAt DateTime?  @db.Timestamptz(6)
  user          User?      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([destination, channel, purpose, createdAt])
  @@index([expiresAt])
}

model AuthSession {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  context           SessionContext
  mfaVerifiedAt     DateTime?      @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  lastSeenAt        DateTime       @db.Timestamptz(6)
  idleExpiresAt     DateTime       @db.Timestamptz(6)
  absoluteExpiresAt DateTime       @db.Timestamptz(6)
  revokedAt         DateTime?      @db.Timestamptz(6)
  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@index([idleExpiresAt])
}

model RefreshToken {
  id           String        @id @default(uuid()) @db.Uuid
  sessionId    String        @db.Uuid
  tokenHash    String        @unique
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime      @db.Timestamptz(6)
  consumedAt   DateTime?     @db.Timestamptz(6)
  revokedAt    DateTime?     @db.Timestamptz(6)
  replacedById String?       @unique @db.Uuid
  session      AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  replacement  RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces     RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@index([expiresAt])
}
